<UserControl x:Class="TemUiClone.UserControls.RightSidebarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="220"
             Background="#FF2D2D30">
    <DockPanel>
        <!-- Color bar (vertical, right edge) -->
        <Border DockPanel.Dock="Right" Width="18" Margin="2">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFFFFFFF" Offset="0.0"/>
                    <GradientStop Color="#FFFFFF00" Offset="0.2"/>
                    <GradientStop Color="#FFFF8800" Offset="0.4"/>
                    <GradientStop Color="#FFFF0000" Offset="0.6"/>
                    <GradientStop Color="#FF000088" Offset="0.8"/>
                    <GradientStop Color="#FF000000" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Right panels stack -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="2">

                <!-- ═══ CAMERA ═══ -->
                <GroupBox Header="Camera" Margin="2,2,2,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="Camera"/>
                        <TextBox   Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueBoxStyle}" Text="BF Detector"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="Binning"/>
                        <ComboBox  Grid.Row="1" Grid.Column="1"
                                   Background="{StaticResource ControlBackgroundBrush}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="10" Height="18" Margin="0,1">
                            <ComboBoxItem Content="1x1" IsSelected="True"/>
                            <ComboBoxItem Content="2x2"/>
                            <ComboBoxItem Content="4x4"/>
                        </ComboBox>

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="Exposure"/>
                        <TextBox   Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueBoxStyle}" Text="0.50 s"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="Gain"/>
                        <TextBox   Grid.Row="3" Grid.Column="1" Style="{StaticResource ValueBoxStyle}" Text="1.0"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="Size"/>
                        <TextBox   Grid.Row="4" Grid.Column="1" Style="{StaticResource ValueBoxStyle}" Text="2048 × 2048"/>
                    </Grid>
                </GroupBox>

                <!-- ═══ HISTOGRAM ═══ -->
                <GroupBox Header="Histogram" Margin="2,2,2,2">
                    <StackPanel>
                        <!-- Histogram canvas placeholder -->
                        <Canvas Height="60" Background="#FF1A1A1A" Margin="0,2">
                            <!-- Simulated histogram bars -->
                            <Rectangle Canvas.Left="5"   Canvas.Bottom="0" Width="4" Height="10" Fill="#FF4488CC"/>
                            <Rectangle Canvas.Left="10"  Canvas.Bottom="0" Width="4" Height="18" Fill="#FF4488CC"/>
                            <Rectangle Canvas.Left="15"  Canvas.Bottom="0" Width="4" Height="28" Fill="#FF4488CC"/>
                            <Rectangle Canvas.Left="20"  Canvas.Bottom="0" Width="4" Height="42" Fill="#FF4488CC"/>
                            <Rectangle Canvas.Left="25"  Canvas.Bottom="0" Width="4" Height="55" Fill="#FF4488CC"/>
                            <Rectangle Canvas.Left="30"  Canvas.Bottom="0" Width="4" Height="58" Fill="#FF4488CC"/>
                            <Rectangle Canvas.Left="35"  Canvas.Bottom="0" Width="4" Height="52" Fill="#FF4488CC"/>
                            <Rectangle Canvas.Left="40"  Canvas.Bottom="0" Width="4" Height="44" Fill="#FF4488CC"/>
                            <Rectangle Canvas.Left="45"  Canvas.Bottom="0" Width="4" Height="34" Fill="#FF4488CC"/>
                            <Rectangle Canvas.Left="50"  Canvas.Bottom="0" Width="4" Height="24" Fill="#FF4488CC"/>
                            <Rectangle Canvas.Left="55"  Canvas.Bottom="0" Width="4" Height="15" Fill="#FF4488CC"/>
                            <Rectangle Canvas.Left="60"  Canvas.Bottom="0" Width="4" Height="9"  Fill="#FF4488CC"/>
                            <Rectangle Canvas.Left="65"  Canvas.Bottom="0" Width="4" Height="5"  Fill="#FF4488CC"/>
                            <Rectangle Canvas.Left="70"  Canvas.Bottom="0" Width="4" Height="3"  Fill="#FF4488CC"/>
                        </Canvas>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Min:"/>
                                <TextBox Style="{StaticResource ValueBoxStyle}" Text="0" Width="40"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Max:"/>
                                <TextBox Style="{StaticResource ValueBoxStyle}" Text="65535" Width="45"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- ═══ ADJUSTMENTS ═══ -->
                <GroupBox Header="Adjustments" Margin="2,2,2,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="Brightness"/>
                        <Slider    Grid.Row="0" Grid.Column="1"
                                   Minimum="0" Maximum="100" Value="50"
                                   Foreground="{StaticResource AccentBrush}"
                                   Margin="2,3"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="Contrast"/>
                        <Slider    Grid.Row="1" Grid.Column="1"
                                   Minimum="0" Maximum="100" Value="60"
                                   Foreground="{StaticResource AccentBrush}"
                                   Margin="2,3"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="Gamma"/>
                        <Slider    Grid.Row="2" Grid.Column="1"
                                   Minimum="0" Maximum="100" Value="45"
                                   Foreground="{StaticResource AccentBrush}"
                                   Margin="2,3"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="Colormap"/>
                        <ComboBox  Grid.Row="3" Grid.Column="1"
                                   Background="{StaticResource ControlBackgroundBrush}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="10" Height="18" Margin="0,1">
                            <ComboBoxItem Content="Grayscale" IsSelected="True"/>
                            <ComboBoxItem Content="Hot"/>
                            <ComboBoxItem Content="Jet"/>
                            <ComboBoxItem Content="Viridis"/>
                        </ComboBox>
                    </Grid>
                </GroupBox>

                <!-- ═══ ANNOTATION PROPERTIES ═══ -->
                <GroupBox Header="Annotation Properties" Margin="2,2,2,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="Type"/>
                        <ComboBox  Grid.Row="0" Grid.Column="1"
                                   Background="{StaticResource ControlBackgroundBrush}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="10" Height="18" Margin="0,1">
                            <ComboBoxItem Content="Arrow" IsSelected="True"/>
                            <ComboBoxItem Content="Circle"/>
                            <ComboBoxItem Content="Rectangle"/>
                            <ComboBoxItem Content="Text"/>
                        </ComboBox>

                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="Color"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                            <Rectangle Width="14" Height="14" Fill="#FFFFFF00" Stroke="#FF888888" StrokeThickness="1" Margin="2,0"/>
                            <TextBlock Text="Yellow" Style="{StaticResource FieldLabelStyle}"/>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="Line Width"/>
                        <Slider    Grid.Row="2" Grid.Column="1"
                                   Minimum="1" Maximum="10" Value="2"
                                   Foreground="{StaticResource AccentBrush}"
                                   Margin="2,3"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="Font Size"/>
                        <Slider    Grid.Row="3" Grid.Column="1"
                                   Minimum="8" Maximum="36" Value="12"
                                   Foreground="{StaticResource AccentBrush}"
                                   Margin="2,3"/>
                    </Grid>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
