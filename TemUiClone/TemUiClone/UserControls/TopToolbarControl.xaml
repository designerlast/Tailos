<UserControl x:Class="TemUiClone.UserControls.TopToolbarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FF2D2D30">
    <DockPanel>
        <!-- Menu bar -->
        <Menu DockPanel.Dock="Top"
              Background="#FF2D2D30"
              Foreground="#FFDDDDDD"
              FontSize="11">
            <MenuItem Header="Setup"   Foreground="#FFDDDDDD" Background="#FF2D2D30"/>
            <MenuItem Header="Search"  Foreground="#FFDDDDDD" Background="#FF2D2D30"/>
            <MenuItem Header="Tune"    Foreground="#FFDDDDDD" Background="#FF2D2D30"/>
            <MenuItem Header="SuperX"  Foreground="#FFDDDDDD" Background="#FF2D2D30"/>
            <MenuItem Header="Optics"  Foreground="#FFDDDDDD" Background="#FF2D2D30"/>
            <MenuItem Header="Stage"   Foreground="#FFDDDDDD" Background="#FF2D2D30"/>
            <MenuItem Header="Detectors" Foreground="#FFDDDDDD" Background="#FF2D2D30"/>
            <MenuItem Header="Tools"   Foreground="#FFDDDDDD" Background="#FF2D2D30"/>
            <MenuItem Header="Help"    Foreground="#FFDDDDDD" Background="#FF2D2D30"/>
        </Menu>

        <!-- Icon toolbar -->
        <ToolBar DockPanel.Dock="Top"
                 Background="#FF3E3E42"
                 Foreground="#FFDDDDDD">
            <Button Style="{StaticResource ToolButtonStyle}" ToolTip="New Session">
                <TextBlock Text="&#x25A1;" FontSize="13"/>
            </Button>
            <Button Style="{StaticResource ToolButtonStyle}" ToolTip="Open">
                <TextBlock Text="&#x1F4C2;" FontSize="13"/>
            </Button>
            <Button Style="{StaticResource ToolButtonStyle}" ToolTip="Save">
                <TextBlock Text="&#x1F4BE;" FontSize="13"/>
            </Button>
            <Separator/>
            <Button Style="{StaticResource ToolButtonStyle}" ToolTip="Play / Acquire">
                <TextBlock Text="&#x25BA;" FontSize="13" Foreground="#FF00CC44"/>
            </Button>
            <Button Style="{StaticResource ToolButtonStyle}" ToolTip="Pause">
                <TextBlock Text="&#x23F8;" FontSize="13"/>
            </Button>
            <Button Style="{StaticResource ToolButtonStyle}" ToolTip="Stop">
                <TextBlock Text="&#x25A0;" FontSize="13" Foreground="#FFCC2222"/>
            </Button>
            <Separator/>
            <Button Style="{StaticResource ToolButtonStyle}" ToolTip="Snap">
                <TextBlock Text="&#x1F4F7;" FontSize="13"/>
            </Button>
            <Button Style="{StaticResource ToolButtonStyle}" ToolTip="Record">
                <TextBlock Text="&#x23FA;" FontSize="13" Foreground="#FFCC2222"/>
            </Button>
            <Separator/>
            <Button Style="{StaticResource ToolButtonStyle}" ToolTip="Zoom In">
                <TextBlock Text="&#x1F50D;" FontSize="13"/>
            </Button>
            <Button Style="{StaticResource ToolButtonStyle}" ToolTip="Zoom Out">
                <TextBlock Text="&#x1F50E;" FontSize="13"/>
            </Button>
            <Separator/>
            <Button Style="{StaticResource ToolButtonStyle}" ToolTip="Annotations">
                <TextBlock Text="A" FontSize="13" FontWeight="Bold"/>
            </Button>
            <Button Style="{StaticResource ToolButtonStyle}" ToolTip="Measurement">
                <TextBlock Text="&#x21C4;" FontSize="13"/>
            </Button>
            <Separator/>
            <Button Style="{StaticResource ToolButtonStyle}" ToolTip="Settings">
                <TextBlock Text="&#x2699;" FontSize="13"/>
            </Button>
        </ToolBar>
    </DockPanel>
</UserControl>
