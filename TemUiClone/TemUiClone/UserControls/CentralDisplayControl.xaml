<UserControl x:Class="TemUiClone.UserControls.CentralDisplayControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FF111111">
    <Grid>
        <!-- Dark viewport background -->
        <Rectangle Fill="#FF0A0A0A"/>

        <!-- Concentric circles (TEM diffraction / image area) -->
        <Canvas HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- Outer reference circle -->
            <Ellipse Canvas.Left="50" Canvas.Top="50"
                     Width="600" Height="600"
                     Stroke="#FF333333" StrokeThickness="1"
                     Fill="Transparent"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Canvas>

        <!-- Viewport with concentric circles, centered -->
        <Viewbox Stretch="Uniform" Margin="20">
            <Canvas Width="700" Height="700">
                <!-- Outermost circle -->
                <Ellipse Canvas.Left="0"   Canvas.Top="0"   Width="700" Height="700" Stroke="#FF2A2A2A" StrokeThickness="1.5" Fill="Transparent"/>
                <!-- Large circle -->
                <Ellipse Canvas.Left="50"  Canvas.Top="50"  Width="600" Height="600" Stroke="#FF2E2E2E" StrokeThickness="1"   Fill="Transparent"/>
                <!-- Medium-large -->
                <Ellipse Canvas.Left="125" Canvas.Top="125" Width="450" Height="450" Stroke="#FF333333" StrokeThickness="1"   Fill="Transparent"/>
                <!-- Medium -->
                <Ellipse Canvas.Left="200" Canvas.Top="200" Width="300" Height="300" Stroke="#FF3A3A3A" StrokeThickness="1.5" Fill="Transparent"/>
                <!-- Medium-small -->
                <Ellipse Canvas.Left="262" Canvas.Top="262" Width="176" Height="176" Stroke="#FF404040" StrokeThickness="1"   Fill="Transparent"/>
                <!-- Small inner -->
                <Ellipse Canvas.Left="300" Canvas.Top="300" Width="100" Height="100" Stroke="#FF484848" StrokeThickness="1.5" Fill="Transparent"/>
                <!-- Innermost -->
                <Ellipse Canvas.Left="325" Canvas.Top="325" Width="50"  Height="50"  Stroke="#FF505050" StrokeThickness="1"   Fill="Transparent"/>

                <!-- Crosshair lines -->
                <Line X1="350" Y1="0"   X2="350" Y2="700" Stroke="#FF2A2A2A" StrokeThickness="0.8"/>
                <Line X1="0"   Y1="350" X2="700" Y2="350" Stroke="#FF2A2A2A" StrokeThickness="0.8"/>

                <!-- Scale bar at bottom -->
                <Rectangle Canvas.Left="80" Canvas.Top="640" Width="80" Height="3" Fill="#FFBBBBBB"/>
                <TextBlock Canvas.Left="80" Canvas.Top="625"
                           Text="10 nm" Foreground="#FFBBBBBB" FontSize="12"/>
            </Canvas>
        </Viewbox>

        <!-- Status text overlay (upper-left of display) -->
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,4">
            <TextBlock Text="SA  36000x" Foreground="#FFDDDDDD" FontSize="11" FontFamily="Consolas"/>
            <TextBlock Text="TEM  Bright Field" Foreground="#FFDDDDDD" FontSize="11" FontFamily="Consolas"/>
            <TextBlock Text="200 kV" Foreground="#FFDDDDDD" FontSize="11" FontFamily="Consolas"/>
        </StackPanel>

        <!-- Exposure / counts overlay (upper-right) -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8,4">
            <TextBlock Text="Counts: 12345" Foreground="#FF888888" FontSize="10" FontFamily="Consolas"/>
            <TextBlock Text="Exp: 0.50 s"   Foreground="#FF888888" FontSize="10" FontFamily="Consolas"/>
        </StackPanel>
    </Grid>
</UserControl>
