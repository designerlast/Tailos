<Application x:Class="TemUiClone.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Global color palette -->
        <Color x:Key="PanelBackgroundColor">#FF2D2D30</Color>
        <Color x:Key="PanelBorderColor">#FF3F3F46</Color>
        <Color x:Key="ControlBackgroundColor">#FF1E1E1E</Color>
        <Color x:Key="AccentColor">#FF007ACC</Color>
        <Color x:Key="TextPrimaryColor">#FFDDDDDD</Color>
        <Color x:Key="TextSecondaryColor">#FF9B9B9B</Color>
        <Color x:Key="GreenIndicatorColor">#FF00AA00</Color>
        <Color x:Key="RedIndicatorColor">#FFCC2222</Color>
        <Color x:Key="YellowIndicatorColor">#FFDDAA00</Color>

        <SolidColorBrush x:Key="PanelBackgroundBrush"  Color="{StaticResource PanelBackgroundColor}"/>
        <SolidColorBrush x:Key="PanelBorderBrush"      Color="{StaticResource PanelBorderColor}"/>
        <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{StaticResource ControlBackgroundColor}"/>
        <SolidColorBrush x:Key="AccentBrush"            Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="TextPrimaryBrush"       Color="{StaticResource TextPrimaryColor}"/>
        <SolidColorBrush x:Key="TextSecondaryBrush"     Color="{StaticResource TextSecondaryColor}"/>
        <SolidColorBrush x:Key="GreenIndicatorBrush"    Color="{StaticResource GreenIndicatorColor}"/>
        <SolidColorBrush x:Key="RedIndicatorBrush"      Color="{StaticResource RedIndicatorColor}"/>
        <SolidColorBrush x:Key="YellowIndicatorBrush"   Color="{StaticResource YellowIndicatorColor}"/>

        <!-- Panel header style -->
        <Style x:Key="PanelHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="FontWeight"  Value="Bold"/>
            <Setter Property="Margin"      Value="4,2,4,2"/>
        </Style>

        <!-- Label style for sidebar fields -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize"    Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"      Value="2,1,4,1"/>
        </Style>

        <!-- Value box style -->
        <Style x:Key="ValueBoxStyle" TargetType="TextBox">
            <Setter Property="Background"  Value="{StaticResource ControlBackgroundBrush}"/>
            <Setter Property="Foreground"  Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="FontSize"    Value="10"/>
            <Setter Property="Height"      Value="18"/>
            <Setter Property="Padding"     Value="2,1"/>
            <Setter Property="IsReadOnly"  Value="True"/>
        </Style>

        <!-- Button style (small toolbar-like) -->
        <Style x:Key="ToolButtonStyle" TargetType="Button">
            <Setter Property="Background"  Value="{StaticResource PanelBackgroundBrush}"/>
            <Setter Property="Foreground"  Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="FontSize"    Value="10"/>
            <Setter Property="Padding"     Value="4,2"/>
            <Setter Property="Margin"      Value="1"/>
        </Style>

        <!-- Groupbox style -->
        <Style TargetType="GroupBox">
            <Setter Property="Foreground"        Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush"        Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="Background"         Value="{StaticResource PanelBackgroundBrush}"/>
            <Setter Property="FontSize"           Value="10"/>
            <Setter Property="Padding"            Value="4"/>
            <Setter Property="Margin"             Value="2"/>
        </Style>

        <!-- Status bar label style -->
        <Style x:Key="StatusLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize"    Value="10"/>
            <Setter Property="Margin"      Value="0,0,4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatusValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize"    Value="10"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Margin"      Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Application.Resources>
</Application>
